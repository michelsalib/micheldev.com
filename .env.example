# Copy to .env and fill in. Bun loads .env automatically, so `bun run dev` and
# `bun start` pick these up with no extra step.
#
# Every one of them is optional. The site builds, serves and passes its tests
# with this file absent entirely — each variable only adds something that cannot
# be derived from content/, and the code treats "unset" as a supported state
# rather than an error. That is what keeps a fresh clone working.

# ── The CV contact line ──────────────────────────────────────────────────────
# PDF-only, and never committed: content/ is public and cv.schema.json forbids
# both keys under `person`. Unset simply prints the PDFs without a contact line.
# CI supplies the same two as repository secrets.
CV_EMAIL=
CV_PHONE=

# ── Cloudflare zone analytics ────────────────────────────────────────────────
# Behind two figures on /stats.json: the visit count under the hero tiles, and
# the traffic line on the Notion connectors plate. Unset and both are absent —
# every other live figure comes from public APIs and needs no credential.
#
# The token is an API token, NOT the Global API Key, scoped to
# Zone > Analytics > Read on this one zone. The zone id is on the zone's
# Overview page in the Cloudflare dashboard.
CF_API_TOKEN=
CF_ZONE_ID=

# In production these two tokens arrive packed into one variable instead, since
# Cloud Run projects a Secret Manager secret as a single value and one secret
# beats one per credential. Terraform builds it; you would only set it by hand
# to reproduce the deployed configuration locally. The discrete variables above
# take precedence, so leaving this empty is the normal case.
#
#   STATS_CREDENTIALS={"github_token":"…","cloudflare_api_token":"…"}
STATS_CREDENTIALS=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Optional, and worth setting. Everything counted is public, so create a
# fine-grained token with NO permissions at all — it authenticates and grants
# nothing, which is the whole point: 5,000 requests an hour instead of 60.
#
#   github.com/settings/personal-access-tokens/new
#
# Unset, /stats.json calls GitHub anonymously against a 60-an-hour budget shared
# by source IP. A dev session spends about six, once — the route holds its answer
# in memory, so rebuilds reuse it — which is survivable but not free.
#
# In CI the matching repository secret is GH_STATS_TOKEN, because Actions
# reserves the GITHUB_ prefix for the token it injects into every run.
GITHUB_TOKEN=
