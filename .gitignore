node_modules/
dist/

# The PDF source copies. The only build output carrying the email and phone, so
# it stays out of the repo as well as out of dist/ and the image.
.print/

# Terraform local state and vars. `.terraform.lock.hcl` is deliberately NOT
# ignored: it pins provider versions and hashes, so committing it is what makes
# CI resolve the same providers as a local apply.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
# Saved plans are binary, environment-specific and short-lived.
infra/tfplan
infra/*.tfplan

# Source CVs — the exported originals, kept locally only. content/cv.yaml is
# the version that ships.
CV - *.pdf

.DS_Store
*.log
