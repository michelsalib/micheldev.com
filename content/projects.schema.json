{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "micheldev.com projects, archive and links",
  "description": "Drives the /projects section, the open-source archive table, and /elsewhere.",
  "type": "object",
  "additionalProperties": false,
  "required": ["since", "metrics", "active", "archive", "links"],

  "properties": {
    "since": {
      "type": "integer",
      "minimum": 2000,
      "description": "Year of the first public repository. Read only by the `oss_years` metric, so the tile rolls over on 1 January rather than going quietly stale."
    },

    "metrics": {
      "description": "The four headline numbers on the homepage hero. Each must trace to something on this page. Give either a literal `value` or a `derive` key, never both — anything countable from content/ should be derived so it cannot go stale. The CV masthead has its own set, in cv.yaml.",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "oneOf": [{ "required": ["value"] }, { "required": ["derive"] }],
        "properties": {
          "value": { "type": "string" },
          "derive": {
            "description": "Counted at render time. stars: summed over archive.repos. repos: archive.total_repos. live_services: live entries, counting subdomains. oss_years: this year minus `since`.",
            "enum": ["stars", "repos", "live_services", "oss_years"]
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en"],
            "properties": {
              "en": { "type": "string" },
              "fr": { "type": "string" }
            }
          }
        }
      }
    },

    "active": {
      "type": "array",
      "minItems": 1,
      "description": "Current projects. Listed under 'Running now'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "tags", "blurb"],
        "properties": {
          "name": { "type": "string" },
          "url": {
            "type": "string",
            "pattern": "^(https://|/)",
            "description": "Where the row links. A live service should point at the service, not the repo."
          },
          "repo": { "type": "string", "pattern": "^https://" },
          "live": {
            "type": "boolean",
            "description": "Deployed and reachable. Grants the green live dot, which must not be claimed otherwise."
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "The first tag is painted in the section hue."
          },
          "blurb": { "type": "string" },
          "subdomains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "description": "Bare label only — the apex is added when rendering."
            },
            "uniqueItems": true,
            "description": "Must match the subdomains actually mapped in Terraform."
          }
        },
        "dependentRequired": {
          "subdomains": ["live"]
        }
      }
    },

    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "lede", "total_repos", "repos"],
      "properties": {
        "heading": { "type": "string" },
        "lede": { "type": "string" },
        "total_repos": {
          "type": "integer",
          "minimum": 1,
          "description": "Total public repos, for the 'N of M' footer."
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "what", "lang", "stars"],
            "properties": {
              "name": { "type": "string" },
              "what": {
                "type": "string",
                "description": "Quote this if it contains a comma — see the note in projects.yaml."
              },
              "lang": { "type": "string" },
              "stars": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },

    "links": {
      "type": "array",
      "minItems": 1,
      "description": "The /elsewhere grid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "host", "note"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^(https://|/)" },
          "host": {
            "type": "string",
            "description": "Displayed under the name — the bare host and path, no scheme."
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
