# Copy to terraform.tfvars for local applies. CI passes these as TF_VAR_*
# environment variables instead, so this file is gitignored.

project_id  = "micheldev-www"
region      = "us-central1"
github_repo = "michelsalib/micheldev.com"

# Overwritten by CI with the commit-tagged image. This placeholder lets the very
# first apply create the service before any image exists.
image = "us-docker.pkg.dev/cloudrun/container/hello"

domain_apex  = "micheldev.com"
domain_alias = "michelsalib.com"

# Leave false until every domain is verified in Search Console under the account
# that owns this project. Then flip it and re-apply.
enable_domain_mappings = false

# `gcloud billing accounts list`. Empty disables the budget and its IAM binding.
billing_account = ""
budget_amount   = 5
